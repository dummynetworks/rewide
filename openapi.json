{
  "openapi": "3.1.0",
  "info": {
    "title": "Rewide Search API",
    "version": "1.0.0",
    "description": "Public, read-only open-web search API. The v1 response contract is independent of the current D1 and crawler adapters."
  },
  "servers": [
    {
      "url": "/",
      "description": "The Rewide website origin"
    }
  ],
  "paths": {
    "/api/v1/search": {
      "get": {
        "operationId": "searchWeb",
        "summary": "Search the indexed and discovered open web",
        "description": "Searches the current index and submits returned URLs for asynchronous refresh when the server-side crawler integration is configured. A search does not discover arbitrary unseen URLs.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query. Terms are interpreted literally and combined with AND.",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "example": "open web"
          }
        ],
        "responses": {
          "200": {
            "description": "Search completed, including an empty result set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                },
                "examples": {
                  "withResults": {
                    "value": {
                      "apiVersion": 1,
                      "query": "example domain",
                      "count": 0,
                      "results": [],
                      "crawl": {
                        "enabled": true,
                        "requested": 1,
                        "fresh": 0,
                        "queued": 1,
                        "deduplicated": 0,
                        "cooldown": 0,
                        "failed": 0,
                        "targets": [
                          {
                            "url": "https://example.com/",
                            "status": "queued",
                            "reason": "CRAWL_QUEUED",
                            "retryAfterAt": null,
                            "jobId": "d5b8b33b-ef33-4b39-90aa-e4cd0848a4c4"
                          }
                        ]
                      },
                      "mode": "discovery-first",
                      "discovery": {
                        "enabled": true,
                        "requested": 1
                      },
                      "pending": true,
                      "pollUrl": "/api/v1/search/status?q=example%20domain&jobId=d5b8b33b-ef33-4b39-90aa-e4cd0848a4c4"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid, too long, or too complex query.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Required search retrieval failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The configured Discovery provider request failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Search database binding is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "preflightSearch",
        "summary": "CORS preflight for search",
        "responses": {
          "204": {
            "description": "Cross-origin GET requests are allowed. No credentials are enabled."
          }
        }
      }
    },
    "/api/v1/search/status": {
      "get": {
        "operationId": "getSearchCrawlStatus",
        "summary": "Wait for discovery-first crawl jobs and retrieve indexed results",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          {
            "name": "jobId",
            "in": "query",
            "required": true,
            "description": "Repeat for each crawl job; between 1 and 10 UUIDs are accepted.",
            "schema": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "style": "form",
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "Pending job state or matching indexed documents once all jobs are terminal.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchStatusResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query or job IDs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Search status or result retrieval failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Database or crawler status binding is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "options": {
        "operationId": "preflightSearchStatus",
        "summary": "CORS preflight for search status polling",
        "responses": {
          "204": {
            "description": "Cross-origin GET requests are allowed. No credentials are enabled."
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SearchResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "query",
          "count",
          "results",
          "crawl"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "query": {
            "type": "string"
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "results": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          },
          "crawl": {
            "$ref": "#/components/schemas/CrawlSummary"
          },
          "mode": {
            "type": "string",
            "enum": [
              "indexed-legacy",
              "discovery-first"
            ]
          },
          "discovery": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "enabled",
              "requested"
            ],
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "requested": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            }
          },
          "pending": {
            "type": "boolean"
          },
          "pollUrl": {
            "type": "string"
          }
        }
      },
      "SearchResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "resultType",
          "indexStatus",
          "url",
          "title",
          "description",
          "snippet",
          "canonicalUrl",
          "language",
          "fetchedAt",
          "sourceUrl",
          "discoveredAt"
        ],
        "properties": {
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "resultType": {
            "type": "string",
            "enum": [
              "document",
              "discovered"
            ]
          },
          "indexStatus": {
            "type": "string",
            "enum": [
              "INDEXABLE",
              "UNKNOWN"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "snippet": {
            "type": "string"
          },
          "canonicalUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "language": {
            "type": [
              "string",
              "null"
            ]
          },
          "fetchedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "discoveredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CrawlSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "enabled",
          "requested",
          "fresh",
          "queued",
          "deduplicated",
          "cooldown",
          "failed",
          "targets"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "requested": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "fresh": {
            "type": "integer",
            "minimum": 0
          },
          "queued": {
            "type": "integer",
            "minimum": 0
          },
          "deduplicated": {
            "type": "integer",
            "minimum": 0
          },
          "cooldown": {
            "type": "integer",
            "minimum": 0
          },
          "failed": {
            "type": "integer",
            "minimum": 0
          },
          "targets": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/CrawlTarget"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "error"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_QUERY",
                  "QUERY_TOO_LONG",
                  "QUERY_TOO_COMPLEX",
                  "SEARCH_QUERY_FAILED",
                  "SEARCH_BACKEND_UNAVAILABLE",
                  "DISCOVERY_NOT_CONFIGURED",
                  "DISCOVERY_URL_INVALID",
                  "DISCOVERY_FETCH_UNAVAILABLE",
                  "DISCOVERY_PROVIDER_UNAVAILABLE",
                  "DISCOVERY_PROVIDER_FAILED",
                  "DISCOVERY_RATE_LIMITED",
                  "DISCOVERY_RESPONSE_INVALID",
                  "DISCOVERY_REQUEST_INVALID",
                  "CRAWLER_NOT_CONFIGURED",
                  "CRAWLER_URL_INVALID",
                  "CRAWLER_FETCH_UNAVAILABLE",
                  "INVALID_CRAWL_JOBS"
                ]
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "CrawlTarget": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "status",
          "reason",
          "retryAfterAt"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "string",
            "enum": [
              "fresh",
              "queued",
              "deduplicated",
              "cooldown",
              "failed"
            ]
          },
          "reason": {
            "type": "string"
          },
          "retryAfterAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "jobId": {
            "type": "string"
          },
          "httpStatus": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "fetchedAt": {
            "type": "string",
            "format": "date-time"
          },
          "ttlExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "previousFailureAt": {
            "type": "string",
            "format": "date-time"
          },
          "upstreamHttpStatus": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 100,
            "maximum": 599
          }
        }
      },
      "SearchJob": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "jobId",
          "status"
        ],
        "properties": {
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed",
              "unknown"
            ]
          },
          "pagesCrawled": {
            "type": "integer",
            "minimum": 0
          },
          "pagesFailed": {
            "type": "integer",
            "minimum": 0
          },
          "pagesSkipped": {
            "type": "integer",
            "minimum": 0
          },
          "errorCode": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "SearchStatusResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "apiVersion",
          "query",
          "pending",
          "jobs",
          "count",
          "results"
        ],
        "properties": {
          "apiVersion": {
            "const": 1
          },
          "query": {
            "type": "string"
          },
          "pending": {
            "type": "boolean"
          },
          "jobs": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/SearchJob"
            }
          },
          "count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10
          },
          "results": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          }
        }
      }
    }
  }
}
